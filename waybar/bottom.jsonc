{
        "mod": "dock",
        "name": "main",
        "layer": "top",
        "position": "bottom",
        // "margin": "0 10 10 10",
        "margin": "0 400 10 400",
        // "margin": "0 10 0 10",
        "height": 36,
        "fixed-center": false,
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": false,
        "reload_style_on_change": true,
        "modules-left": [
                "custom/separators",
                "custom/cpu_graph"
        ],
        "modules-right": [
                "custom/privacy",
                "custom/separators",
                "custom/recording",
                "group/hardware"
        ],
        //-- HYPRLAND ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
        "group/hardware": {
                "orientation": "horizontal",
                "modules": [
                        "network",
                        "custom/separators",
                        "cpu",
                        "custom/separators",
                        "memory",
                        "custom/separators",
                        "temperature",
                        "custom/separators",
                        "custom/gpuinfo",
                        "custom/separators",
                        "battery",
                        "custom/separators"
                ]
        },
        "network": {
                "format-wifi": " {essid} ",
                "format-ethernet": " {ifname} ",
                "tooltip": false,
                "on-click": "wifimenu -o i",
                "interval": 1,
                "min-length": 1,
                "max-length": 20
        },
        "cpu": {
                "states": {
                        "good": 30,
                        "warning": 50,
                        "critical": 80
                },
                "format": " {usage}% ",
                "on-click": "cpu",
                "tooltip": true,
                "interval": 1,
                "min-length": 1,
                "max-length": 6
        },
        //-- CPU TEMPERATURE ---------------------------------------------------------------------------------------------------------------------------------------------------------------
        "temperature": {
                "hwmon-path": "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon3/temp1_input",
                "critical-treshold": 10,
                "interval": 1,
                "format": " {temperatureC}°C "
        },
        "memory": {
                "states": {
                        "good": 30,
                        "warning": 50,
                        "critical": 80
                },
                "format": " {used} ",
                "format-critical": " {percentage}% ",
                "tooltip": true,
                "tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
                "interval": 5,
                "min-length": 1,
                "max-length": 7
        },
        "battery": {
                "states": {
                        "full": 100,
                        "good": 99,
                        "warning": 50,
                        "critical": 15
                },
                "on-click": "swaync-client -t",
                "format": " {capacity} ",
                "format-full": " {capacity} ",
                "format-warning": " {capacity} ",
                "format-critical": " {capacity} ",
                "format-charging": " {capacity} ",
                "tooltip-format": "Time to Empty: {time}",
                "tooltip-format-charging": "Time to Full: {time}",
                "interval": 1,
                "min-length": 1,
                "max-length": 5
        },
        //-- CUSTOM ------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        "custom/cpu_graph": {
                "exec": "cpu_graph",
                "return-type": "json"
        },
        "custom/privacy": {
                "exec": "privacy",
                "return-type": "json",
                "format": "{text}",
                "interval": 1,
                "tooltip": true,
                "escape": false,
                "markup": "pango"
        },
        "custom/recording": {
                "exec": "recording w",
                "return-type": "json",
                "format": "{} ",
                "max-length": 8,
                "tooltip": false,
                "interval": 1
        },
        "custom/wifi": {
                "exec": "wifiinfo",
                "return-type": "json",
                "format": "{}",
                "tooltip": true,
                "on-click": "wifimenu -o i",
                "interval": 1,
                "min-length": 1,
                "max-length": 7
        },
        "custom/gpuinfo": {
                "exec": "gpuinfo",
                "return-type": "json",
                "format": " {} ",
                "tooltip": true,
                "interval": 5,
                "min-length": 4,
                "max-length": 8,
                "menu": "on-click",
                "menu-file": "~/.config/waybar/menu/gpu.xml",
                "menu-actions": {
                        "Default": "gpu d",
                        "Overclock": "gpu o",
                        "Low": "gpu l"
                }
        },
        "custom/separator": {
                "format": ""
        },
        "custom/separators": {
                "format": " "
        }
}
